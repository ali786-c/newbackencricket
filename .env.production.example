APP_NAME=STUMPS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_TIMEZONE=UTC
CORS_ALLOWED_ORIGINS=https://app.example.com

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=stumps
DB_USERNAME=stumps_app
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
FILESYSTEM_DISK=public

STUMPS_TOKEN_EXPIRATION_MINUTES=43200
STUMPS_ROLLOUT_STAGE=internal_alpha
STUMPS_API_RATE_LIMIT=180
STUMPS_SYNC_MONITOR_WINDOW_MINUTES=15
STUMPS_SYNC_CONFLICT_WARNING_THRESHOLD=10
STUMPS_SYNC_REJECTION_WARNING_THRESHOLD=10
